<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/7.7.0/rti_recording_service.xsd">

  <configuration_variables>
    <value>
      <element><name>SPIKE_LOG_DIR</name><value>test_output/qos_analysis_spike</value></element>
      <element><name>SPIKE_EXEC_DIR</name><value>recording</value></element>
    </value>
  </configuration_variables>

  <recording_service name="qos_analysis_spike">
    <storage>
      <sqlite>
        <storage_format>XCDR_AUTO</storage_format>
        <fileset>
          <workspace_dir>$(SPIKE_LOG_DIR)</workspace_dir>
          <execution_dir_expression>$(SPIKE_EXEC_DIR)</execution_dir_expression>
          <filename_expression>data_%auto:0-9%.db</filename_expression>
        </fileset>
      </sqlite>
    </storage>

    <domain_participant name="RecorderParticipant">
      <domain_id>42</domain_id>
    </domain_participant>

    <session name="DiscoveryOnly">
      <topic_group name="BuiltinDiscovery" participant_ref="RecorderParticipant">
        <allow_topic_name_filter>DCPSParticipant,DCPSPublication,DCPSSubscription</allow_topic_name_filter>
      </topic_group>
    </session>
  </recording_service>
</dds>